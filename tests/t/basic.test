# Basic SQL: create table, insert, select, filter, order, limit.
create table t1 (id bigint, name varchar(20), score bigint, primary key (id));
insert into t1 values (1, 'alice', 90);
insert into t1 values (2, 'bob', 75);
insert into t1 values (3, 'carol', 90);
insert into t1 (id, name, score) values (4, 'dave', 60);
select id, name, score from t1;
select * from t1;
select id, name from t1 where score > 70;
select id from t1 where score = 90;
select id from t1 where score >= 75 and score <= 90;
select id from t1 where name = 'bob';
select id, name from t1 order by score desc;
select id from t1 order by score, id;
select id from t1 limit 2;
select id from t1 limit 2 offset 1;
select id from t1 where id in (1, 3);
select id from t1 where id between 2 and 3;
select id from t1 where name like 'a%';
select count(*) from t1;
