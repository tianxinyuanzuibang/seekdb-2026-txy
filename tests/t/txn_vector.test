-- Vector retrieval inside an explicit transaction must see that
-- transaction's own changes (statement section 2.3).
create table tv (id bigint, e vector(2), primary key (id));
begin;
insert into tv values (9, '[1,1]');
select id from tv order by l2_distance(e, '[0,0]') limit 5;
insert into tv values (10, '[2,2]');
select id from tv order by l2_distance(e, '[0,0]') limit 5;
update tv set e = '[5,5]' where id = 9;
select id from tv order by l2_distance(e, '[0,0]') limit 1;
rollback;
select id from tv order by l2_distance(e, '[0,0]') limit 5;
begin;
insert into tv values (11, '[3,3]');
commit;
select id from tv order by l2_distance(e, '[0,0]') limit 5;
